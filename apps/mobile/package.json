{
  "name": "@private-protection/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "On-device threat, phishing, and scam protection mobile application for Android",
  "main": "src/index.ts",
  "scripts": {
    "build:web": "vite build",
    "sync:assets": "node scripts/copy-assets.js",
    "build": "vite build && node scripts/copy-assets.js",
    "build:apk": "vite build && node scripts/copy-assets.js && cd android && .\\gradlew.bat assembleDebug",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@private-protection/core": "*",
    "@private-protection/ml": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.1.2",
    "@types/node": "^22.13.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^24.0.0",
    "typescript": "^5.3.3",
    "vite": "^6.0.1",
    "vitest": "*"
  }
}
