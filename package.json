{
  "name": "private-protection",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@private-protection/core && npm run build --workspace=@private-protection/ml && npm run build --workspace=@private-protection/web",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "package": "node scripts/package-release.js",
    "audit:secrets": "node scripts/audit-secrets.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
